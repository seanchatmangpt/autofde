{%- set object_properties = sparql(query='PREFIX owl: <http://www.w3.org/2002/07/owl#> SELECT ?property WHERE { ?property a owl:ObjectProperty . FILTER(STRSTARTS(STR(?property), "https://seanchatmangpt.github.io/autofde/ontology#")) } ORDER BY ?property') -%}
{%- set datatype_properties = sparql(query='PREFIX owl: <http://www.w3.org/2002/07/owl#> SELECT ?property WHERE { ?property a owl:DatatypeProperty . FILTER(STRSTARTS(STR(?property), "https://seanchatmangpt.github.io/autofde/ontology#")) } ORDER BY ?property') -%}
{%- set annotation_properties = sparql(query='PREFIX owl: <http://www.w3.org/2002/07/owl#> SELECT ?property WHERE { ?property a owl:AnnotationProperty . FILTER(STRSTARTS(STR(?property), "https://seanchatmangpt.github.io/autofde/ontology#")) } ORDER BY ?property') -%}
{%- set modules = sparql(query='PREFIX autofde: <https://seanchatmangpt.github.io/autofde/ontology#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?moduleId ?label ?coordinate ?comment ?order WHERE { ?m a autofde:CapabilityModule ; autofde:moduleId ?moduleId ; rdfs:label ?label ; autofde:order ?order . OPTIONAL { ?m autofde:sourceCoordinate ?coordinate } OPTIONAL { ?m rdfs:comment ?comment } } ORDER BY ?order') -%}
{%- set refusals = sparql(query='PREFIX autofde: <https://seanchatmangpt.github.io/autofde/ontology#> SELECT ?code WHERE { ?r a autofde:RefusalCode ; autofde:refusalCode ?code . } ORDER BY ?code') -%}
