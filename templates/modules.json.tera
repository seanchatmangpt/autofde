{# GENERATED by ggen from ontology/autofde.ttl. #}
{%- set modules = sparql(query='PREFIX autofde: <https://seanchatmangpt.github.io/autofde/ontology#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?moduleId ?label ?coordinate ?comment ?order WHERE { ?m a autofde:CapabilityModule ; autofde:moduleId ?moduleId ; rdfs:label ?label ; autofde:order ?order . OPTIONAL { ?m autofde:sourceCoordinate ?coordinate } OPTIONAL { ?m rdfs:comment ?comment } } ORDER BY ?order') -%}
{
  "schema": "autofde.module-manifest.v1",
  "execution_mode": "EXPLOIT",
  "modules": [
{% for m in modules -%}
    {
      "id": "{{ m.moduleId }}",
      "name": "{{ m.label }}",
      "compatibility_coordinate": "{{ m.coordinate }}",
      "responsibility": "{{ m.comment }}"
    }{% if not loop.last %},{% endif %}
{% endfor -%}
  ]
}
